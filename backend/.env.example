# Server
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5446/balkan_giveaways?schema=public"

# Auth
JWT_SECRET=change_me_to_a_strong_random_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# Frontend URL (used for password reset links, CORS, etc.)
FRONTEND_URL=http://localhost:3001

# SMTP (production) — leave empty to use Ethereal test accounts in dev
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_email_password
# SMTP_FROM="Balkan Giveaways <noreply@yourdomain.com>"
