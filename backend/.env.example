# Server
PORT=3000

# Public URL of this API server (optional - used to build absolute URLs for locally uploaded images,
# e.g. https://api.example.com). If unset, the request's protocol/host is used.
# PUBLIC_URL=https://api.example.com

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5446/balkan_giveaways?schema=public"

# Auth
JWT_SECRET=change_me_to_a_strong_random_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# Frontend URL (used for password reset links, CORS, etc.)
FRONTEND_URL=http://localhost:3001

# SMTP (production) — leave empty to use Ethereal test accounts in dev
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_email_password
# SMTP_FROM="Balkan Giveaways <noreply@yourdomain.com>"

# Cloudflare R2 (optional - if set, images will be uploaded to R2 instead of local storage)
# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key_id
# R2_SECRET_ACCESS_KEY=your_secret_access_key
# R2_BUCKET_NAME=your_bucket_name
# R2_PUBLIC_URL=https://your-bucket.r2.dev

# Image uploads (local fallback)
# Without R2 configured, uploaded images are stored in backend/uploads/
# and served from <PUBLIC_URL or http://localhost:PORT>/uploads/

